balance = 1000
withdrawal_amount = 600

if withdrawal_amount <= balance:
    # Nested check begins here
    if withdrawal_amount <= 500:
        balance -= withdrawal_amount
        print("Withdrawal successful.")
    else:
        print("Exceeds daily ATM limit.")
else:
